diff --git a/tests/components/assist_satellite/test_entity.py b/tests/components/assist_satellite/test_entity.py
--- a/tests/components/assist_satellite/test_entity.py
+++ b/tests/components/assist_satellite/test_entity.py
@@ -1,5 +1,6 @@
 """Tests for assist satellite entity."""
 
+import asyncio
 from unittest.mock import patch
 
 import pytest
@@ -200,3 +201,42 @@ async def test_conversation_id(
         blocking=True,
     )
     assert response["response"]["speech"]["plain"]["speech"] == "Done"
+
+
+async def test_stop_pipeline(
+    hass: HomeAssistant,
+    init_components: ConfigEntry,
+    entity: MockAssistSatellite,
+) -> None:
+    """Test that the stop_pipeline service cancels the running pipeline."""
+    pipeline_started = asyncio.Event()
+    pipeline_cancelled = asyncio.Event()
+
+    async def async_pipeline_from_audio_stream(*args, **kwargs):
+        pipeline_started.set()
+        try:
+            await asyncio.Event().wait()
+        except asyncio.CancelledError:
+            pipeline_cancelled.set()
+            raise
+
+    with patch(
+        "homeassistant.components.assist_satellite.entity.async_pipeline_from_audio_stream",
+        new=async_pipeline_from_audio_stream,
+    ):
+        hass.async_create_task(
+            entity.async_accept_pipeline_from_satellite(
+                object(),
+            )
+        )
+
+        async with asyncio.timeout(1):
+            await pipeline_started.wait()
+
+        await hass.services.async_call(
+            "assist_satellite",
+            "stop_pipeline",
+            {},
+            target={"entity_id": "assist_satellite.test_entity"},
+            blocking=True,
+        )
+
+        async with asyncio.timeout(1):
+            await pipeline_cancelled.wait()
+
+    assert entity.state == AssistSatelliteState.IDLE
