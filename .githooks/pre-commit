#!/usr/bin/env bash
# Pre-commit hook: validate staged Home Assistant YAML before commit.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Secrets: this repository is public on GitHub. Scan the staged changes with gitleaks and
# refuse the commit on any finding (fail closed if gitleaks is missing). Real values belong
# in .env (compose ${VAR}) or secrets.yaml (!secret), both gitignored.
GITLEAKS="$(command -v gitleaks || true)"
[ -z "$GITLEAKS" ] && [ -x /home/linuxbrew/.linuxbrew/bin/gitleaks ] && GITLEAKS=/home/linuxbrew/.linuxbrew/bin/gitleaks
if [ -z "$GITLEAKS" ]; then
    echo "COMMIT ABORTED: gitleaks is not installed (brew install gitleaks); the repo is public."
    exit 1
fi
if ! "$GITLEAKS" git --pre-commit --staged --redact --no-banner --config .gitleaks.toml; then
    echo ""
    echo "COMMIT ABORTED: gitleaks found a secret in the staged changes."
    echo "Move it to .env or secrets.yaml and rotate it if it was ever pushed."
    exit 1
fi

mapfile -t STAGED_FILES < <(
    git diff --cached --name-only --diff-filter=ACMR
)

YAML_FILES=()
LOVELACE_FILES=()

for file in "${STAGED_FILES[@]}"; do
    if [[ "$file" =~ \.ya?ml$ ]]; then
        YAML_FILES+=("$file")
    fi

    case "$file" in
        configuration.yaml|ui-*.yaml|ui-*.yml|www/*.js|scripts/ha_validate_lovelace.*|.githooks/pre-commit)
            LOVELACE_FILES+=("$file")
            ;;
    esac
done

if [ "${#YAML_FILES[@]}" -eq 0 ] && [ "${#LOVELACE_FILES[@]}" -eq 0 ]; then
    exit 0
fi

if [ "${#YAML_FILES[@]}" -gt 0 ]; then
    echo "[pre-commit] Validating YAML files..."

    if ! scripts/ha_validate_yaml.sh "${YAML_FILES[@]}"; then
        echo ""
        echo "COMMIT ABORTED: Fix YAML errors first."
        echo "Check: scripts/ha_validate_yaml.sh FILE.yaml"
        exit 1
    fi
fi

if [ "${#LOVELACE_FILES[@]}" -gt 0 ]; then
    echo "[pre-commit] Validating Lovelace dashboards..."

    if ! scripts/ha_validate_lovelace.sh "${LOVELACE_FILES[@]}"; then
        echo ""
        echo "COMMIT ABORTED: Fix Lovelace dashboard/resource errors first."
        echo "Check: scripts/ha_validate_lovelace.sh FILE"
        exit 1
    fi
fi

echo "[pre-commit] HA YAML/Lovelace checks passed. Proceeding with commit."
